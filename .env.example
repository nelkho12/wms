# ============================================================================
# ApexWMS service settings.  Copy this file to ".env" (same folder as server.cjs)
# and fill in your own values.  NEVER commit the real .env file to GitHub.
# ============================================================================

# Port the desktop apps connect to (open this one port in the Windows firewall).
PORT=3000

# ---- Microsoft SQL Server --------------------------------------------------
# Use "localhost" when the service runs on the same PC as SQL Server (recommended:
# then SQL Server does not need to be reachable from the network at all).
MSSQL_SERVER=localhost
MSSQL_PORT=1433
# Only if you use a named instance such as SQL Server Express (localhost\SQLEXPRESS):
# leave MSSQL_PORT as is and uncomment the next line.
# MSSQL_INSTANCE=SQLEXPRESS
MSSQL_DATABASE=ApexWMS
MSSQL_USER=apex_wms_app
MSSQL_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD
# true = encrypt the connection (needed when SQL Server is on another computer)
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERT=true

# ---- First start only -------------------------------------------------------
# The first administrator account. If ADMIN_PASSWORD is empty, a random password
# is generated and printed once in the service window.
ADMIN_EMAIL=admin@mayralab.local
ADMIN_PASSWORD=
# What to load into an empty database:
#   master = product catalog, bin locations, zones, customers (recommended)
#   demo   = also sample batches, orders and users (for trying things out only)
#   none   = nothing
SEED_MODE=master

# ---- Optional ----------------------------------------------------------------
# How long a login lasts, in hours.
SESSION_HOURS=12
# Leave empty: a secret is generated and stored in the database automatically.
AUTH_SECRET=
# Only for the AI advisor feature.
GEMINI_API_KEY=
